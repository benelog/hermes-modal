# Example only. Do not put real secrets in git.

# Required
TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
TELEGRAM_ALLOWED_USERS=7160469912
TELEGRAM_WEBHOOK_SECRET=generate-with-python-secrets-token-urlsafe-32
TELEGRAM_WEBHOOK_URL=https://YOUR-WORKSPACE--hermes-telegram-gateway-gateway.modal.run/telegram

# Required if qmd repos are private. Prefer a fine-grained read-only token.
GITHUB_TOKEN=github_pat_...
# Or use SSH deploy key instead:
# GIT_SSH_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----'

# Current local default uses OpenAI Codex OAuth copied from ~/.hermes/auth.json.
HERMES_AUTH_JSON_B64=base64-encoded-auth-json
HERMES_MODEL_PROVIDER=openai-codex
HERMES_MODEL=gpt-5.5
HERMES_MODEL_BASE_URL=https://chatgpt.com/backend-api/codex

# Alternative: use an API key provider instead of OAuth.
# HERMES_MODEL_PROVIDER=openrouter
# HERMES_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_API_KEY=sk-or-...

QMD_LLAMA_GPU=false
