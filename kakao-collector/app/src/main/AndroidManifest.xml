<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ 패키지 가시성: 백필 시작 시 카카오톡을 앞으로 띄우는
         getLaunchIntentForPackage(com.kakao.talk)가 이 선언 없이는 null을 돌려준다. -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".CollectorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KakaoCollector">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdvancedSettingsActivity"
            android:exported="false"
            android:label="@string/advanced_settings_title"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".KakaoCollectorService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
